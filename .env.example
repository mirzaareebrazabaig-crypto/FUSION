# Or PostgreSQL for Supabase / Railway / RDS:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# ==========================================
# APP & BRAND SETTINGS
# ==========================================
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_BRAND_NAME="ChocoFusion"
NEXT_PUBLIC_BRAND_CITY="Mumbai"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
ADMIN_SECRET_KEY="chocofusion2026"

NEXT_PUBLIC_DEFAULT_DELIVERY_FEE=75
NEXT_PUBLIC_FREE_DELIVERY_THRESHOLD=999

# ==========================================
# RAZORPAY PAYMENT GATEWAY
# ==========================================
# Generate your Test/Live Key ID and Key Secret from https://dashboard.razorpay.com/app/keys
